# ==========================================
# ITR-TaxPilot — Environment Configuration
# ==========================================

# Application Settings
APP_NAME=ITR-TaxPilot
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-use-a-secure-random-32-byte-hex-key

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/itrtaxpilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=itrtaxpilot
POSTGRES_PORT=5432

# Cache & Queue Configuration (Redis 7)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# AI Provider API Keys (Never commit real keys!)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_AI_PROVIDER=gemini

# Document Processing & Security Thresholds
MAX_UPLOAD_SIZE_MB=10
DOCUMENT_RETENTION_MINUTES=30
ALLOWED_MIME_TYPES=application/pdf

# Logging & Telemetry
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_PII_MASKING=True
